# ==============================================================================
# searxng-mcp-gateway Configuration (Go v2.0)
# ==============================================================================

# URL of the SearXNG instance (default: http://127.0.0.1:8889)
SEARXNG_URL=http://127.0.0.1:8889

# Default number of search results per request (default: 10)
SEARXNG_DEFAULT_MAX=10

# Maximum allowed results per request (default: 50)
SEARXNG_MAX_ALLOWED=50

# Default search language (default: auto)
SEARXNG_DEFAULT_LANG=auto

# SafeSearch content filter: 0=off, 1=moderate, 2=strict (default: 0)
SEARXNG_SAFESEARCH=0

# Timeout for SearXNG requests in seconds (default: 10)
SEARXNG_TIMEOUT=10

# Timeout for external API cascade (Exa / Tavily) in seconds (default: 6)
CASCADE_TIMEOUT=6

# Reciprocal Rank Fusion constant k (default: 60)
RRF_K=60

# Directory for RAM-disk ephemeral key vault (default: /dev/shm/agent_vault)
AGENT_VAULT_DIR=/dev/shm/agent_vault
