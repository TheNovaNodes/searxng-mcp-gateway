# Nova-SearXNG-MCP Configuration
# Copy this file to .env and fill in your values

# SearXNG search endpoint (no trailing slash)
SEARXNG_URL=http://127.0.0.1:8889

# --- Search Defaults ---
DEFAULT_MAX_RESULTS=10
DEFAULT_LANGUAGE=auto
DEFAULT_SAFESEARCH=0

# --- Search Parameters ---
DEFAULT_TIMEOUT=30

# --- Deep Research Orchestrator ---
DEEP_RESEARCH_ORCHESTRATOR=/path/to/research-orchestrator.py
DEEP_RESEARCH_TIMEOUT=60

# --- Semantic Memory Integration (from memory-gateway) ---
SEMANTIC_ENABLED=0
SEMANTIC_TOP_K=5
SEMANTIC_EXPAND=1
SEMANTIC_FUSION=weighted

# --- MCP Transport ---
MG_TRANSPORT=stdio
MG_HOST=127.0.0.1
MG_PORT=8092